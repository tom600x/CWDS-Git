+using System;
+using System.Collections.Generic;
+using System.Linq;
+using GitTfs.Core;
+using GitTfs.Core.TfsInterop;
+using GitTfs.Util;
+using Moq;
+using Xunit;
+
+namespace GitTfs.Test.Core
+{
+    public class RenameSourceOverrideTests
+    {
+        private const string OverrideKey = "GIT_TFS_RENAME_SOURCE_41562_11797985";
+        private const string Destination = "$/Archive/file.gif";
+        private const string Source = "$/Original/file.gif";
+
+        [Theory]
+        [InlineData(true, false, false, false)]
+        [InlineData(false, false, false, false)]
+        [InlineData(true, true, false, false)]
+        [InlineData(true, false, true, false)]
+        [InlineData(true, false, false, true)]
+        [InlineData(false, false, false, true)]
+        [InlineData(true, false, true, true)]
+        public void VerifiesSourceBeforeAvoidingHistory(bool sourceExists, bool wrongDestination, bool deletedSource, bool branchRule)
+        {
+            var key = branchRule ? "GIT_TFS_RENAME_BRANCH_41562" : OverrideKey;
+            var original = Environment.GetEnvironmentVariable(key);
+            try
+            {
+                Environment.SetEnvironmentVariable(key, branchRule ? "$/Archive|$/Original" :
+                    (wrongDestination ? "$/Wrong/file.gif" : Destination) + "|" + Source);
+                var server = new Mock<IVersionControlServer>(MockBehavior.Strict);
+                server.Setup(s => s.GetItem(11797985, 41561)).Returns((IItem)null);
+                var oldItem = new Mock<IItem>();
+                oldItem.SetupGet(i => i.ServerItem).Returns(Source);
+                oldItem.SetupGet(i => i.ItemType).Returns(TfsItemType.File);
+                oldItem.SetupGet(i => i.DeletionId).Returns(deletedSource ? 1 : 0);
+                server.Setup(s => s.GetItem(Source, 41561)).Returns(sourceExists ? oldItem.Object : null);
+                var item = new Mock<IItem>();
+                item.SetupGet(i => i.VersionControlServer).Returns(server.Object);
+                item.SetupGet(i => i.ItemId).Returns(11797985);
+                item.SetupGet(i => i.ChangesetId).Returns(41562);
+                item.SetupGet(i => i.ServerItem).Returns(Destination);
+                item.SetupGet(i => i.ItemType).Returns(TfsItemType.File);
+                var change = new Mock<IChange>();
+                change.SetupGet(c => c.Item).Returns(item.Object);
+                change.SetupGet(c => c.ChangeType).Returns(TfsChangeType.Rename);
+                var changeset = new Mock<IChangeset>();
+                changeset.SetupGet(c => c.Changes).Returns(new[] { change.Object });
+                var remote = new Mock<IGitTfsRemote>();
+                remote.Setup(r => r.GetPathInGitRepo(It.IsAny<string>()))
+                    .Returns((string p) => p == Destination ? "file.gif" : null);
+                var subject = new ChangeSieve(changeset.Object,
+                    new PathResolver(remote.Object, "", new Dictionary<string, GitObject>()));
+
+                if (sourceExists && !wrongDestination && !deletedSource)
+                {
+                    var applied = subject.GetChangesToApply().ToArray();
+                    Assert.Single(applied);
+                    Assert.Equal(ChangeType.Update, applied[0].Type);
+                    Assert.Equal("file.gif", applied[0].GitPath);
+                    server.Verify(s => s.GetItem(Source, 41561), Times.Once);
+                }
+                else
+                {
+                    Assert.Throws<GitTfsException>(() => subject.GetChangesToApply().ToArray());
+                }
+                server.Verify(s => s.QueryHistory(It.IsAny<string>(), It.IsAny<int>(), It.IsAny<int>(),
+                    It.IsAny<TfsRecursionType>(), It.IsAny<string>(), It.IsAny<int>(), It.IsAny<int>(),
+                    It.IsAny<int>(), It.IsAny<bool>(), It.IsAny<bool>(), It.IsAny<bool>()), Times.Never);
+            }
+            finally
+            {
+                Environment.SetEnvironmentVariable(key, original);
+            }
+        }
+    }
+}
